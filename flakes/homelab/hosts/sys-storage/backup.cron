# BorgWarehouse cron jobs
# Status check: updates repo status (last save, alert state) and sends notifications
0 * * * * curl -sf --data "" -H "Authorization: Bearer $CRONJOB_KEY" "http://host.containers.internal:3000/api/v1/cron/status"
# Storage check: updates storage usage for each repository
0 * * * * curl -sf --data "" -H "Authorization: Bearer $CRONJOB_KEY" "http://host.containers.internal:3000/api/v1/cron/storage"